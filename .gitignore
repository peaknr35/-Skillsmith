# secrets: never commit
.env
.env.*
!.env.example

# run workspaces hold the extracted text of source documents and model outputs; keep them local
runs/

# the original workspace template folder (contains an unmoved copy of a run); not part of the published layout
source-to-skill/

# source documents (copyright stays with their authors)
*.pdf
!engine/tests/fixtures/*.pdf

# python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
build/lib/
dist/
.coverage

# system-prompts: only our own reference work is tracked; third-party collections stay local
# (licences and origins unchecked)
system-prompts/*
!system-prompts/README.md
!system-prompts/dsh-superagent/
!system-prompts/general/
